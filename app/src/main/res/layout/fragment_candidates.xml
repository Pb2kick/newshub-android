<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_back" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/candidates_title"
            android:textColor="@color/home_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="National General Election 2026" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_candidates"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        tools:listitem="@layout/item_candidate" />

    <TextView
        android:id="@+id/text_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/candidates_empty"
        android:textColor="@color/home_text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_candidates"
        app:layout_constraintEnd_toEndOf="@id/recycler_candidates"
        app:layout_constraintStart_toStartOf="@id/recycler_candidates"
        app:layout_constraintTop_toTopOf="@id/recycler_candidates" />

    <ProgressBar
        android:id="@+id/progress_candidates"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_candidates"
        app:layout_constraintEnd_toEndOf="@id/recycler_candidates"
        app:layout_constraintStart_toStartOf="@id/recycler_candidates"
        app:layout_constraintTop_toTopOf="@id/recycler_candidates" />

</androidx.constraintlayout.widget.ConstraintLayout>

