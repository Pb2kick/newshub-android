<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_menu"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/home_text_secondary" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/home_brand"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_newshub_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/home_brand"
            android:textColor="@color/home_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/button_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/news_refresh"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/home_text_secondary" />

        <ImageButton
            android:id="@+id/button_profile_shortcut"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_home_chip_muted"
            android:contentDescription="@string/home_nav_profile"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="@color/home_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_screen_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:text="@string/elections_title"
        android:textColor="@color/home_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_elections"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        android:paddingBottom="72dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_screen_title"
        tools:listitem="@layout/item_election" />

    <TextView
        android:id="@+id/text_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/elections_empty"
        android:textColor="@color/home_text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_elections"
        app:layout_constraintEnd_toEndOf="@id/recycler_elections"
        app:layout_constraintStart_toStartOf="@id/recycler_elections"
        app:layout_constraintTop_toTopOf="@id/recycler_elections" />

    <ProgressBar
        android:id="@+id/progress_elections"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_elections"
        app:layout_constraintEnd_toEndOf="@id/recycler_elections"
        app:layout_constraintStart_toStartOf="@id/recycler_elections"
        app:layout_constraintTop_toTopOf="@id/recycler_elections" />

    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/partial_bottom_nav_elections"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


