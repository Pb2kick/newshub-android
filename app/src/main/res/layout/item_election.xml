<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/home_card_bg"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/home_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/text_election_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/home_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="National General Election 2026" />

        <TextView
            android:id="@+id/text_election_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/home_muted"
            android:textSize="12sp"
            tools:text="OPEN • 2026-05-01 • 2026-05-05" />

        <TextView
            android:id="@+id/text_election_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/home_text_secondary"
            android:textSize="13sp"
            tools:text="Choose local and national representatives for the 2026 term." />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

