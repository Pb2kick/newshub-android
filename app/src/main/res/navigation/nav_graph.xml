<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.newshub.feature.auth.login.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.newshub.feature.auth.register.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />

        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.newshub.feature.home.HomeFragment"
        android:label="@string/home_brand"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_homeFragment_to_newsDetailFragment"
            app:destination="@id/newsDetailFragment" />

        <action
            android:id="@+id/action_homeFragment_to_electionsFragment"
            app:destination="@id/electionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/newsDetailFragment"
        android:name="com.example.newshub.feature.news.NewsDetailFragment"
        android:label="@string/news_detail_title"
        tools:layout="@layout/fragment_news_detail" />

    <fragment
        android:id="@+id/electionsFragment"
        android:name="com.example.newshub.feature.elections.ElectionsFragment"
        android:label="@string/elections_title"
        tools:layout="@layout/fragment_elections">

        <action
            android:id="@+id/action_electionsFragment_to_candidatesFragment"
            app:destination="@id/candidatesFragment" />
    </fragment>

    <fragment
        android:id="@+id/candidatesFragment"
        android:name="com.example.newshub.feature.elections.CandidatesFragment"
        android:label="@string/candidates_title"
        tools:layout="@layout/fragment_candidates">

        <action
            android:id="@+id/action_candidatesFragment_to_voteConfirmFragment"
            app:destination="@id/voteConfirmFragment" />
    </fragment>

    <fragment
        android:id="@+id/voteConfirmFragment"
        android:name="com.example.newshub.feature.voting.VoteConfirmFragment"
        android:label="@string/vote_confirm_title"
        tools:layout="@layout/fragment_vote_confirm">

        <action
            android:id="@+id/action_voteConfirmFragment_to_voteVerificationFragment"
            app:destination="@id/voteVerificationFragment" />
    </fragment>

    <fragment
        android:id="@+id/voteVerificationFragment"
        android:name="com.example.newshub.feature.voting.VoteVerificationFragment"
        android:label="@string/vote_verification_title"
        tools:layout="@layout/fragment_vote_verification" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.newshub.feature.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>
</navigation>